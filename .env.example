# TorBox Media Server — Environment Configuration Template
#
# This file is for **non-interactive** setup via `bash setup.sh --yes`.
# Set the variables you care about in your shell before running setup.sh —
# they will be picked up automatically. Do NOT copy this file to
# `torbox-media-server/.env`; setup.sh generates that file for you with
# all the values (generated API keys, admin passwords, paths, etc.).
#
# Non-interactive quick start:
#   TORBOX_API_KEY="your-key" TORBOX_MEDIA_SERVER="plex" bash setup.sh --yes

# ── Required ────────────────────────────────────────────────────
# Paste your TorBox API key here (get it from https://torbox.app/settings)
TORBOX_API_KEY=""

# ── Media server selection ──────────────────────────────────────
# Media server: "plex" (default), "jellyfin", or "silo" (Linux)
# TORBOX_MEDIA_SERVER="plex"

# Plex claim token (only needed for first-time Plex setup; expires in 4 min).
# Get it from https://www.plex.tv/claim/
# TORBOX_PLEX_CLAIM="claim-xxxxxxxxxxxxxxxx"

# ── Optional paths ──────────────────────────────────────────────
# Custom mount directory (Linux default: /mnt/torbox-media, Windows default: C:\torbox-media)
# TORBOX_MOUNT_DIR="/mnt/torbox-media"

# ── Hardware acceleration ───────────────────────────────────────
# "none" | "intel" | "amd" | "nvidia"
# Auto-detected if not set.
# TORBOX_HW_ACCEL="none"

# ── Service startup ─────────────────────────────────────────────
# Set to "false" to skip starting services after setup completes.
# TORBOX_START_SERVICES="true"

# ── Prowlarr default indexer ────────────────────────────────────
# URL for the default public indexer added to Prowlarr on first run.
# TORBOX_INDEXER_URL="https://1337x.to"

# ── Optional AIOStreams / Usenet ────────────────────────────────
# AIOStreams is disabled by default. Enable it during setup or with:
#   TORBOX_ENABLE_AIOSTREAMS=true TORBOX_AIOSTREAMS_USENET_MODE=both bash setup.sh --yes
# Modes: both (direct streaming + Radarr/Sonarr), direct, or arr.
# The installer keeps credentials in the installed private .env only.
# TORBOX_ENABLE_AIOSTREAMS="false"
# TORBOX_AIOSTREAMS_USENET_MODE="both"
# TORBOX_AIOSTREAMS_PORT="3000"
# Generated setup defaults to the detected LAN IP (localhost if no LAN address
# is available). Override this for a stable hostname, reverse proxy, or HTTPS.
# TORBOX_AIOSTREAMS_BASE_URL="http://192.168.1.50:3000"
# Disk cache in bytes. 0 keeps media bytes off local disk; set a bounded value
# such as 2147483648 (2 GiB) if you want faster repeat playback/seeking.
# TORBOX_AIOSTREAMS_CACHE_BYTES="0"
# TORBOX_AIOSTREAMS_USER="aiostreams"
# TORBOX_AIOSTREAMS_PASS=""
# Newshosting or another NNTP provider (optional; dashboard setup remains available):
# TORBOX_USENET_HOST="news.newshosting.com"
# TORBOX_USENET_PORT="563"
# TORBOX_USENET_TLS="true"
# TORBOX_USENET_USER=""
# TORBOX_USENET_PASS=""
# TORBOX_USENET_CONNECTIONS="20"
# Optional Newznab/AltHub details are saved for dashboard setup:
# TORBOX_NEWZNAB_URL=""
# TORBOX_NEWZNAB_API_KEY=""
# TORBOX_AIOSTREAMS_MOUNT_DIR="/mnt/aiostreams"

# Optional native Decypharr Usenet integration (independent of AIOStreams):
# Set true to add a SABnzbd-compatible client to Radarr/Sonarr. Torrents still
# use the TorBox qBittorrent-compatible client. Lower Arr priority wins.
# TORBOX_DECYPHARR_USENET_ENABLED="false"
# TORBOX_DECYPHARR_USENET_PRIORITY="0"
# Empty disk path keeps media bytes in Decypharr's bounded memory window.
# TORBOX_DECYPHARR_USENET_DISK_PATH=""
# For one or more providers, use Decypharr's JSON schema (keep this private):
# TORBOX_DECYPHARR_USENET_PROVIDERS='[{"host":"news.provider.com","port":563,"username":"user","password":"pass","backbone":"Omicron","ssl":true,"max_connections":20,"priority":1,"backup":false}]'

# ── Optional image overrides ───────────────────────────────────
# Compose follows each upstream image's latest stable tag by default. Set any
# of these to a release tag or immutable digest when you need a rollback.
# DECYPHARR_IMAGE="cy01/blackhole:latest"
# PROWLARR_IMAGE="lscr.io/linuxserver/prowlarr:latest"
# BYPARR_IMAGE="ghcr.io/thephaseless/byparr:latest"
# RADARR_IMAGE="lscr.io/linuxserver/radarr:latest"
# SONARR_IMAGE="lscr.io/linuxserver/sonarr:latest"
# BAZARR_IMAGE="lscr.io/linuxserver/bazarr:latest"
# SEERR_IMAGE="ghcr.io/seerr-team/seerr:latest"
# PLEX_IMAGE="lscr.io/linuxserver/plex:latest"
# JELLYFIN_IMAGE="lscr.io/linuxserver/jellyfin:latest"
# AIOSTREAMS_IMAGE="ghcr.io/viren070/aiostreams:latest"
# SILO_OMNIBUS_IMAGE="ghcr.io/silo-server/silo-server:latest"

# ── Notes on auto-generated variables ───────────────────────────
# The following variables are auto-generated by setup.sh on first run
# and stored in torbox-media-server/.env (NOT this file):
#
#   PUID, PGID           — auto-detected from `id -u`/`id -g`
#   TZ                   — auto-detected from `timedatectl` or /etc/timezone
#   CONFIG_DIR, DATA_DIR — derived from the install directory
#   INSTALL_DIR          — <repo>/torbox-media-server
#   COMPOSE_PROFILES     — auto-set from TORBOX_MEDIA_SERVER (do NOT set manually)
#   RADARR_API_KEY       — 32-char hex, generated via openssl
#   SONARR_API_KEY       — 32-char hex, generated via openssl
#   PROWLARR_API_KEY     — 32-char hex, generated via openssl
#   BAZARR_API_KEY       — 32-char hex, generated via openssl
#   RADARR_ADMIN_USER    — defaults to "admin"
#   RADARR_ADMIN_PASS    — 32-char base64, generated via openssl
#   SONARR_ADMIN_USER    — defaults to "admin"
#   SONARR_ADMIN_PASS    — 32-char base64, generated via openssl
#   PROWLARR_ADMIN_USER  — defaults to "admin"
#   PROWLARR_ADMIN_PASS  — 32-char base64, generated via openssl
#   DECYPHARR_USER       — defaults to "torbox"
#   DECYPHARR_PASS       — 12-char base64, generated via openssl
#
# On re-runs, all of these are preserved (kept from the existing .env)
# so your integrations keep working. View them with:
#   cd torbox-media-server && ./manage.sh keys

# Optional Linux Silo server: choose it during the main setup with
# TORBOX_MEDIA_SERVER=silo, or add it alongside an existing server with
# TORBOX_ENABLE_SILO=true. See docs/SILO.md. Settings below belong in the
# INSTALLED .env, not this installer-input template.
# SILO_SECRET_KEY is generated ONCE by the add-on; save it separately forever.
# SILO_PUID/SILO_PGID default to the stack IDs, except root becomes 911:911.
# SILO_GPU=dri (default) or none; TORBOX_SILO_GPU selects it when adding Silo.
# Optional installed settings:
# SILO_HTTP_PORT=8090
# SILO_JF_PORT=8097
# SILO_ABS_PORT=13379
# SILO_ADMIN_USER=admin
# SILO_ADMIN_EMAIL=admin@torbox.local
# SILO_ADMIN_PASS=generated-and-stored-by-setup
# SILO_WORK_DIR=/path/to/install/silo-work
# SILO_OMNIBUS_IMAGE=ghcr.io/silo-server/silo-server:latest
# Keep the generated COMPOSE_FILE and comma-separated COMPOSE_PROFILES values.
# Once Silo is enabled, use --refresh-management / add-silo.sh rather than
# rerunning full setup.sh, which intentionally refuses to rewrite its settings.
